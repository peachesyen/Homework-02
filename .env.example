# Copy this file to .env and fill in what you have. Nothing here is required
# for the agent to run end-to-end — without keys it uses deterministic
# offline fallbacks (see README.md) so you can demo the full pipeline for free.

# --- Required for real LLM output (gpt-5.6-luna) and OpenAI TTS (tts-1-hd) ---
OPENAI_API_KEY=

# Only set this if your course gives you a proxy/gateway URL that serves
# gpt-5.6-luna under the standard OpenAI Chat Completions API shape.
# OPENAI_BASE_URL=

# --- Optional: use Gemini for more expressive narration instead of tts-1-hd ---
# REEL_TTS_PROVIDER=gemini
# GOOGLE_API_KEY=

# --- Optional overrides (defaults shown) ---
# REEL_LLM_MODEL=gpt-5.6-luna
# REEL_TTS_MODEL=tts-1-hd
# REEL_TTS_VOICE=alloy
# REEL_TTS_PROVIDER=openai

# Only needed if Playwright can't auto-locate its installed Chromium build
# (e.g. a sandboxed environment with a non-standard browser path).
# CHROMIUM_EXECUTABLE_PATH=
