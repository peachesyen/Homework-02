# Copy this file to .env and fill in your real key.
# .env is gitignored — never commit real API keys.

# Required. All LLM output (the planner and critic agents) uses
# openai:gpt-5.6-luna — this is a hard assignment requirement, not a
# provider default that shifts. LLM_MODEL below should not normally be
# changed; it's only overridable for local development against a
# different provider (see README for why that override exists).
OPENAI_API_KEY=sk-proj-your-key-here
LLM_MODEL=openai:gpt-5.6-luna

# TTS provider: "openai" (tts-1-hd, required default) or "gemini" (an
# explicitly allowed substitution for narration only, for a more
# expressive voice — does not apply to the planner/critic LLM calls above).
TTS_PROVIDER=openai
# TTS_MODEL=tts-1-hd

# Only needed if TTS_PROVIDER=gemini above, or if you override LLM_MODEL
# to a Google model for local testing:
# GEMINI_API_KEY=your-gemini-key-here

# Optional overrides — sane defaults are already baked into reel_agent.py.
# FFMPEG_BIN=/path/to/ffmpeg
# CHROME_PATH=/path/to/chromium
# MAX_CONCURRENT_API_CALLS=3
# MAX_CONCURRENT_TTS=4
